# SovereignForge — .gitignore

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment
venv/
env/
.venv/
ENV/

# pytest
.pytest_cache/
tests/__pycache__/

# Node.js / Next.js
frontend/node_modules/
frontend/.next/
frontend/.npm/
frontend/out/
frontend/build/

# Environment variables
.env
.env.local
.env.production
*.env

# Docker
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# Sentence-transformers cache (large, download on first run)
backend/tools/.cache/

# Generated outputs (runtime artifacts, not source)
# (Keep fixtures in tests/fixtures/ — those are tracked)

# Compiled Python extensions
*.so
*.pyd

# mypy
.mypy_cache/
.dmypy.json
